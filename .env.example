# Contract Guardian — environment variables
#
# Copy this file to `.env.local` (Next.js will load that automatically in dev)
# and fill in real values. Never commit `.env.local` or any file with real
# secrets — only this example.

# ─────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────
# Public URL of your Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key from Supabase → Project Settings → API (safe to expose).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (anon key)

# Direct Postgres connection string used by LangGraph's PostgresSaver
# for durable agent checkpoints. Grab this from Supabase → Project Settings
# → Database → Connection string. NEVER expose to the browser.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────
# Google Gemini (used by the LangGraph agent + notification extractor)
# ─────────────────────────────────────────────────────────────────────
# Google AI Studio API key. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Foxit — PDF Services (MCP)
# The agent's reversible PDF tools (pdf_to_text, pdf_from_html, etc.)
# come from this MCP server. Get credentials from the Foxit developer
# portal for PDF Services / Cloud API.
# ─────────────────────────────────────────────────────────────────────
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Foxit — eSign REST (used only by routeSigners.ts at approval time)
# Separate from the PDF Services / MCP credentials above.
# ─────────────────────────────────────────────────────────────────────
FOXIT_BASE_URL=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
