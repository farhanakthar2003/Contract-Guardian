# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# caches
.eslintcache
.turbo/
.cache/

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# env files — commit .env.example only
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# local downloads / bundles (do not commit any Node runtime we shipped in the repo dir)
/node-v*/

